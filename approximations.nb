Cell[CellGroupData[{

Cell["3. Logarithm", "Chapter",
 CellChangeTimes->{{3.999925216141033*^9, 
  3.9999252232700644`*^9}},ExpressionUUID->"f3a30258-fff8-4ab2-bbd7-\
1ee166792873"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "Log2ChebyshevPolynomial", ",", "Log2ChebyshevRationalPolynomial", " ", ",",
      "MaxErrLog2"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Log2ChebyshevPolynomial", "[", 
    RowBox[{"x_", ",", 
     RowBox[{"degree_Integer", "?", "NonNegative"}], ",", 
     RowBox[{"precision_", ":", "50"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nodes", ",", "values"}], "}"}], ",", 
     RowBox[{
      RowBox[{"nodes", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"3", "/", "4"}], "+", 
            RowBox[{
             RowBox[{"1", "/", "4"}], " ", 
             RowBox[{"Cos", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", " ", "k"}], "+", "1"}], ")"}], " ", 
               RowBox[{"Pi", "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"2", " ", "degree"}], "+", "2"}], ")"}]}]}], 
              "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", "degree"}], "}"}]}], "]"}], ",", 
         "precision"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"values", "=", 
       RowBox[{"Log", "[", 
        RowBox[{"2", ",", "nodes"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Expand", "[", 
       RowBox[{"InterpolatingPolynomial", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"nodes", ",", "values"}], "}"}], "]"}], ",", "x"}], "]"}], 
       "]"}]}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Log2ChebyshevRationalPolynomial", "[", 
    RowBox[{"x_", ",", 
     RowBox[{"degree_Integer", "?", "NonNegative"}], ",", 
     RowBox[{"tolerance_", ":", 
      RowBox[{"2", "^", 
       RowBox[{"-", "16"}]}]}]}], "]"}], ":=", 
   RowBox[{"Rationalize", "[", 
    RowBox[{
     RowBox[{"Log2ChebyshevPolynomial", "[", 
      RowBox[{"x", ",", "degree", ",", "80"}], "]"}], ",", "tolerance"}], 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MaxErrLog2", "[", 
   RowBox[{"approx_", ",", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "a_", ",", "b_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"NMaxValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"approx", "-", 
        RowBox[{"Log2", "[", "x", "]"}]}], "]"}], ",", 
      RowBox[{"a", "<=", "x", "<=", "b"}]}], "}"}], ",", "x", ",", " ", 
    RowBox[{"WorkingPrecision", "->", "40"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.998623238553877*^9, 3.998623243611527*^9}, {
  3.9999252950275087`*^9, 3.999925337040485*^9}, {3.999925394382661*^9, 
  3.99992540805587*^9}, {3.9999254843249903`*^9, 3.999925484447682*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"02f1d834-6b70-444a-aa77-c349314e5230"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", " ", "=", " ", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{"MaxErrLog2", "[", 
        RowBox[{
         RowBox[{"Log2ChebyshevPolynomial", "[", 
          RowBox[{"x", ",", " ", "i"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"x", ",", " ", 
           RowBox[{"1", "/", "2"}], ",", " ", "1"}], "}"}]}], "]"}]}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"TableForm", "[", 
  RowBox[{"data", ",", 
   RowBox[{"TableHeadings", "->", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
