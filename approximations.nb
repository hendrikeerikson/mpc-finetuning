Notebook[{

Cell[CellGroupData[{
Cell["Minimax Approximation Polynomials for Ndfloat16 Protocols", "Title",
 CellChangeTimes->{{3.999923147840528*^9, 
  3.999923171314115*^9}},ExpressionUUID->"6580b5c8-da02-4131-8bb5-\
d4caf95b2d23"],

Cell[CellGroupData[{

Cell["1. Inversion", "Chapter",
 CellChangeTimes->{{3.999923185426393*^9, 
  3.999923187720428*^9}},ExpressionUUID->"354b266d-a263-4aa9-b292-\
0333eacdb6e7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "MaxErrInv", ",", " ", "SymmetricReciprocalPolynomial", ",", " ", 
     "SymmetricReciprocalNewton"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MaxErrInv", "[", 
    RowBox[{"approx_", ",", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "a_", ",", "b_"}], "}"}]}], "]"}], ":=", 
   RowBox[{"NMaxValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"approx", "-", 
         RowBox[{"1", "/", "x"}]}], "]"}], ",", 
       RowBox[{"a", "<=", "x", "<=", "b"}]}], "}"}], ",", "x", ",", " ", 
     RowBox[{"WorkingPrecision", "->", "40"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SymmetricReciprocalPolynomial", "[", 
    RowBox[{"x_", ",", 
     RowBox[{"degree_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", "residual", ",", "q"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"residual", "=", 
       RowBox[{
        RowBox[{"ChebyshevT", "[", 
         RowBox[{
          RowBox[{"degree", "+", "1"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"8", " ", "t"}], "-", "5"}], ")"}], "/", "3"}]}], "]"}], 
        "/", 
        RowBox[{"ChebyshevT", "[", 
         RowBox[{
          RowBox[{"degree", "+", "1"}], ",", 
          RowBox[{
           RowBox[{"-", "5"}], "/", "3"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"q", "=", 
       RowBox[{"Cancel", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", "residual"}], ")"}], "/", "t"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Expand", "[", 
       RowBox[{
        RowBox[{"x", " ", "q"}], "/.", " ", 
        RowBox[{"t", "->", 
         RowBox[{"x", "^", "2"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SymmetricReciprocalNewton", "[", 
   RowBox[{"x_", ",", 
    RowBox[{"seedDegree_Integer", "?", "NonNegative"}], ",", 
    RowBox[{"newtonSteps_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "seed", "}"}], ",", 
    RowBox[{
     RowBox[{"seed", "=", 
      RowBox[{"SymmetricReciprocalPolynomial", "[", 
       RowBox[{"x", ",", "seedDegree"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"Nest", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Expand", "[", 
         RowBox[{"#", " ", 
          RowBox[{"(", 
           RowBox[{"2", "-", 
            RowBox[{"x", " ", "#"}]}], ")"}]}], "]"}], "&"}], ",", "seed", ",",
        "newtonSteps"}], "]"}]}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.997762926007802*^9, 3.997762936365089*^9}, {
   3.999923014429392*^9, 3.9999230587013206`*^9}, 3.999923773052293*^9, {
   3.9999243315256567`*^9, 3.9999243349564466`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"cd263735-f11b-4b67-b941-1e7391e34387"],

