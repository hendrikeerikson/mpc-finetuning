Cell["4. Exponent", "Chapter",
 CellChangeTimes->{{3.999925505363586*^9, 
  3.999925507345578*^9}},ExpressionUUID->"27d4c0d8-9f3f-4ffe-9ec7-\
14dc4737e612"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "Pow2ChebyshevPolynomial", ",", "Pow2ChebyshevRationalPolynomial", ",", 
    "MaxErrPow2"}], "]"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Pow2ChebyshevPolynomial", "[", 
    RowBox[{"r_", ",", 
     RowBox[{"degree_Integer", "?", "NonNegative"}], ",", 
     RowBox[{"precision_", ":", "50"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nodes", ",", "values"}], "}"}], ",", 
     RowBox[{
      RowBox[{"nodes", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"1", "/", "2"}], " ", 
            RowBox[{"Cos", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"2", " ", "k"}], "+", "1"}], ")"}], " ", 
              RowBox[{"Pi", "/", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", " ", "degree"}], "+", "2"}], ")"}]}]}], "]"}]}],
            ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", "degree"}], "}"}]}], "]"}], ",", 
         "precision"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"values", "=", 
       RowBox[{"2", "^", "nodes"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Expand", "[", 
       RowBox[{"InterpolatingPolynomial", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"nodes", ",", "values"}], "}"}], "]"}], ",", "r"}], "]"}], 
       "]"}]}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Pow2ChebyshevRationalPolynomial", "[", 
    RowBox[{"x_", ",", 
     RowBox[{"degree_Integer", "?", "NonNegative"}], ",", 
     RowBox[{"tolerance_", ":", 
      RowBox[{"2", "^", 
       RowBox[{"-", "16"}]}]}]}], "]"}], ":=", 
   RowBox[{"Rationalize", "[", 
    RowBox[{
     RowBox[{"Pow2ChebyshevPolynomial", "[", 
      RowBox[{"x", ",", "degree", ",", "80"}], "]"}], ",", "tolerance"}], 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MaxErrPow2", "[", 
   RowBox[{"approx_", ",", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "a_", ",", "b_"}], "}"}]}], "]"}], ":=", 
  RowBox[{"NMaxValue", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"approx", "-", 
        RowBox[{"(", 
         RowBox[{"2", "^", "x"}], ")"}]}], "]"}], ",", 
      RowBox[{"a", "<=", "x", "<=", "b"}]}], "}"}], ",", "x", ",", " ", 
    RowBox[{"WorkingPrecision", "->", "40"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.998620948825341*^9, 3.998620948826228*^9}, {
