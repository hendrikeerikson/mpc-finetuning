Cell[CellGroupData[{

Cell["\<\

2. Square Root\
\>", "Chapter",
 CellChangeTimes->{{3.99785334889581*^9, 3.997853377147223*^9}, {
  3.999924828798913*^9, 
  3.9999248328412046`*^9}},ExpressionUUID->"5fd64b1a-9509-4cac-8580-\
8cd0d71cd3a3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "SqrtChebyshevPolynomial", ",", " ", "SqrtChebyshevRationalPolynomial", ",",
     " ", "MaxErrSqrt"}], "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SqrtChebyshevPolynomial", "[", "\n", "   ", 
    RowBox[{"x_", ",", "\n", "   ", 
     RowBox[{"degree_Integer", "?", "NonNegative"}], ",", "\n", "   ", 
     RowBox[{"precision_", ":", " ", "50"}]}], "\n", "]"}], " ", ":=", "\n", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nodes", ",", " ", "values"}], "}"}], ",", "\n", "\n", "   ", 
     RowBox[{
      RowBox[{"nodes", " ", "=", " ", 
       RowBox[{"N", "[", "\n", "     ", 
        RowBox[{
         RowBox[{"Table", "[", "\n", "       ", 
          RowBox[{
           RowBox[{
            RowBox[{"3", "/", "4"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"1", "/", "4"}], " ", 
             RowBox[{"Cos", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"2", " ", "k"}], " ", "+", " ", "1"}], ")"}], " ", 
               RowBox[{"Pi", "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"2", " ", "degree"}], " ", "+", " ", "2"}], 
                 ")"}]}]}], "]"}]}]}], ",", "\n", "       ", 
           RowBox[{"{", 
